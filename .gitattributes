# Enforce LF in repository to keep release evidence reproducible
* text=auto eol=lf

# Markdown and text formats
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf

# Binary assets (prevent line-ending normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
